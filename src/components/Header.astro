---
import { site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="site-logo" href="/" aria-label={`${site.name} home`}>
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="13" stroke="#ff4d3d" stroke-width="2.5" />
        <circle cx="16" cy="16" r="4" fill="#ff4d3d" />
        <path d="M16 3v6M16 23v6M3 16h6M23 16h6" stroke="#ff4d3d" stroke-width="2" stroke-linecap="round" />
      </svg>
      {site.name}
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/tools/" aria-current={isActive('/tools') ? 'page' : undefined}>All tools</a>
      <a href="/fov-calculator/" aria-current={isActive('/fov-calculator') ? 'page' : undefined}>FOV</a>
      <a href="/triple-screen-calculator/" aria-current={isActive('/triple-screen') ? 'page' : undefined}>Triple screen</a>
      <a href="/ppd-calculator/" aria-current={isActive('/ppd') ? 'page' : undefined}>PPD</a>
      <a href="/fuel-calculator/" aria-current={isActive('/fuel') ? 'page' : undefined}>Fuel</a>
      <a href="/guides/" aria-current={isActive('/guides') ? 'page' : undefined}>Guides</a>
    </nav>
  </div>
</header>
