---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Terms of Use | RaceCalc';
const description = 'RaceCalc terms of use: free browser tools provided as-is, acceptable use, and limitations of liability.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms' },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/terms/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Terms of use</h1>
    <p class="small muted">Effective date: 08 Oct 2026</p>

    <section class="section">
      <h2 id="service">1. The service</h2>
      <p>
        RaceCalc provides free, browser-based calculators ("the Tools"). By using the site you agree to
        these terms. If you do not agree, do not use the site.
      </p>
    </section>

    <section class="section">
      <h2 id="use">2. Acceptable use</h2>
      <ul>
        <li>Do not attempt to disrupt or scrape at abusive volume.</li>
        <li>Do not resell the Tools as your own or misrepresent results as affiliated with any game or publisher.</li>
        <li>Personal and commercial use of the numbers the Tools produce is fine.</li>
      </ul>
    </section>

    <section class="section">
      <h2 id="accuracy">3. Accuracy &amp; warranties</h2>
      <p>
        The Tools are provided <strong>"as is"</strong>. We work to keep the maths correct and documented
        (see the <a href="/methodology/">methodology page</a>), but setups vary and some game mappings are
        approximations. We make no warranty of fitness for a particular purpose, including league or
        tournament compliance.
      </p>
    </section>

    <section class="section">
      <h2 id="ip">4. Trademarks</h2>
      <p>
        Sim titles referenced on this site (iRacing, Assetto Corsa, Assetto Corsa Competizione, Le Mans
        Ultimate, rFactor 2, Automobilista 2, F1, Gran Turismo and others) are trademarks of their
        respective owners. RaceCalc is not affiliated with, endorsed by, or sponsored by any game
        publisher.
      </p>
    </section>

    <section class="section">
      <h2 id="liability">5. Limitation of liability</h2>
      <p>
        To the maximum extent permitted by law, RaceCalc and its operators are not liable for indirect
        or consequential damages arising from your use of the Tools.
      </p>
    </section>

    <section class="section">
      <h2 id="changes">6. Changes</h2>
      <p>
        We may update these terms; the effective date above always reflects the current version.
        Continued use after changes constitutes acceptance.
      </p>
    </section>

    <section class="section">
      <h2 id="contact-terms">7. Contact</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>
  </div>
</Base>
